FORGE_CONFIG_DIR=<CAMINHO_DA_CONFIGURACAO>
FORGE_LOG_LEVEL=INFO
FORGE_AUTOMATION_ENABLED=true
# Opcional: agentes desativados, separados por vírgula (ex.: echo)
FORGE_AGENTS_DISABLED=
# sqlite:///<CAMINHO>.db (protótipo/testes) ou postgresql://<USUARIO>:<SEGREDO>@127.0.0.1:5433/<BANCO>
FORGE_DATABASE_URL=<URL_DO_BANCO>
# Opcional: URL do papel dono/migrador, usada só para migrar (a aplicação usa FORGE_DATABASE_URL como papel escritor)
FORGE_DATABASE_MIGRATION_URL=<URL_DO_BANCO_MIGRADOR>
# Login humano (ADR-014): client id PÚBLICO do OAuth App com Device Flow. Não há segredo para o device flow.
FORGE_GITHUB_CLIENT_ID=<CLIENT_ID_PUBLICO_DO_OAUTH_APP>
# Rascunho de issue: caminhos/opções, não segredos. FORGE_CURSOR_MODEL é o id que VOCÊ escolhe
# depois de conferir a assinatura (`agent models`). Sem default de custo; não habilita on-demand.
# FORGE_CURSOR_AGENT=   # opcional; Windows resolve agent.cmd via PATH/PATHEXT ou LOCALAPPDATA
# FORGE_CURSOR_MODEL=<MODELO_DA_ASSINATURA>
# FORGE_CURSOR_TIMEOUT=120
# Heap do Node da CLI (só o Forge lê; não vai para o filho). Default 512.
# FORGE_CURSOR_MAX_OLD_SPACE_MB=512
# FORGE_GH_BIN=gh
# Usadas só pelo docker-compose.dev.yml (Postgres de dev/teste)
FORGE_PG_USER=forge
FORGE_PG_PASSWORD=<SEGREDO>
FORGE_PG_DB=forge

# --- Legado (backend antigo; não usado pelo Forge Core) ---
POSTGRES_USER=forge
POSTGRES_PASSWORD=<SENHA>
POSTGRES_DB=forge
DATABASE_URL=postgresql://forge:<SENHA>@127.0.0.1:5432/forge
FORGE_HOST=<HOST>
FORGE_PORT=<PORT>
