FORGE_CONFIG_DIR=<CAMINHO_DA_CONFIGURACAO>
FORGE_LOG_LEVEL=INFO
FORGE_AUTOMATION_ENABLED=true
# Opcional: agentes desativados, separados por vírgula (ex.: echo)
FORGE_AGENTS_DISABLED=
# sqlite:///<CAMINHO>.db (protótipo/testes) ou postgresql://<USUARIO>:<SEGREDO>@127.0.0.1:5433/<BANCO>
FORGE_DATABASE_URL=<URL_DO_BANCO>
# Opcional: URL do papel dono/migrador, usada só para migrar (a aplicação usa FORGE_DATABASE_URL como papel escritor)
FORGE_DATABASE_MIGRATION_URL=<URL_DO_BANCO_MIGRADOR>
# Login humano (ADR-014): client id PÚBLICO do OAuth App com Device Flow. Não há segredo para o device flow.
FORGE_GITHUB_CLIENT_ID=<CLIENT_ID_PUBLICO_DO_OAUTH_APP>
# Rascunho de issue: caminhos/opções, não segredos. FORGE_CURSOR_MODEL é o id que VOCÊ escolhe
# depois de conferir a assinatura (`agent models`). Sem default de custo; não habilita on-demand.
# FORGE_CURSOR_AGENT=   # opcional; Windows resolve agent.cmd via PATH/PATHEXT ou LOCALAPPDATA
# FORGE_CURSOR_MODEL=<MODELO_DA_ASSINATURA>
# FORGE_CURSOR_TIMEOUT=120
# Heap do Node da CLI (só o Forge lê; não vai para o filho). Default 512.
# FORGE_CURSOR_MAX_OLD_SPACE_MB=512
# FORGE_GH_BIN=gh
# Motor LLM do rascunho/resolver: claude (padrão) ou cursor. Sem ANTHROPIC_API_KEY.
# FORGE_ENGINE=claude
# FORGE_CLAUDE_BIN=claude
# FORGE_RESOLVER_ATTEMPTS=1
# Claude Code CLI: teto de turnos por chamada (custo/tempo). Padrão 8.
# FORGE_CLAUDE_MAX_TURNS=8
# Contexto do grafo injetado no prompt do motor (rascunho, resolver e investigação).
# FORGE_GRAPH_PROMPT_MAX_NODES=40
# FORGE_GRAPH_PROMPT_MAX_CHARS=6000
# Usadas só pelo docker-compose.dev.yml (Postgres de dev/teste). Conflita com a 5433 do compose.forge.
FORGE_PG_USER=forge
FORGE_PG_PASSWORD=<SEGREDO>
FORGE_PG_DB=forge

# --- docker-compose.forge.yml (painel local, ADR-017). Só nomes; valores fora do Git. ---
# Senhas: compose secrets com source environment. Nunca em arquivo no repositório.
FORGE_PG_OWNER_PASSWORD=<SEGREDO>
FORGE_PG_APP_PASSWORD=<SEGREDO>
FORGE_PG_READONLY_PASSWORD=<SEGREDO>
# Porta do Postgres no loopback (padrão 5433; igual ao docker-compose.dev.yml — não suba os dois).
FORGE_PG_HOST_PORT=5433
# Origem do navegador (forge_frontend). O backend não publica 8091 no host.
FORGE_FRONTEND_HOST_PORT=8090
# FORGE_SESSION_TTL_SECONDS=28800
# FORGE_COOKIE_SECURE=false
# FORGE_WEB_HOSTS=127.0.0.1:8090,localhost:8090,127.0.0.1:8091,localhost:8091
# No compose.forge: FORGE_TRUST_FORWARDED=true e FORGE_TRUSTED_PROXIES=forge_frontend

# --- Legado (backend antigo; não usado pelo Forge Core) ---
POSTGRES_USER=forge
POSTGRES_PASSWORD=<SENHA>
POSTGRES_DB=forge
DATABASE_URL=postgresql://forge:<SENHA>@127.0.0.1:5432/forge
FORGE_HOST=<HOST>
FORGE_PORT=<PORT>
